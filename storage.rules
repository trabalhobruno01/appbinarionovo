rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Global deny-all default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id.matches('^[a-zA-Z0-9_\\-]{1,128}$');
    }

    // Files strictly isolated by companyId and ownerUid
    match /companies/{companyId}/users/{userId}/{allPaths=**} {
      allow read: if isSignedIn()
        && isValidId(companyId)
        && isValidId(userId)
        && request.auth.uid == userId
        && (resource == null
          || (resource.metadata['ownerUid'] == request.auth.uid
            && resource.metadata['companyId'] == companyId));

      allow create, update: if isSignedIn()
        && isValidId(companyId)
        && isValidId(userId)
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        && request.resource.metadata['ownerUid'] == request.auth.uid
        && request.resource.metadata['companyId'] == companyId;

      allow delete: if isSignedIn()
        && isValidId(companyId)
        && isValidId(userId)
        && request.auth.uid == userId;
    }
  }
}
