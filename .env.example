# GEMINI_API_KEY: Obrigatória para análise visual e conversacional com Gemini AI no backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública do aplicativo (injetada automaticamente no AI Studio ou Netlify).
APP_URL="MY_APP_URL"

# TWELVE_DATA_API_KEY: Opcional — provedor adicional de cotações para ações globais e forex.
# Criptomoedas (Binance), Forex (ECB/Frankfurter) e Ações/B3/Índices (Yahoo Finance) já funcionam sem chave.
TWELVE_DATA_API_KEY=""

# CAPACITOR_SERVER_URL: URL HTTPS da Netlify usada pelo APK Android WebView em produção.
# Exemplo: https://seu-app.netlify.app
CAPACITOR_SERVER_URL=""

# FIREBASE ADMIN SDK (Somente servidor / Netlify Functions — NUNCA expor no frontend)
# Opção 1: Variáveis individuais da Service Account do Firebase
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Opção 2: JSON completo da Service Account em linha única (alternativa às 3 acima)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# FIREBASE CLIENT WEB (Opcional — sobrescreve firebase-applet-config.json no build Vite se configurado)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

